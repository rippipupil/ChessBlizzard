# Configuración del servidor. Para desarrollo, copia este fichero a `.env` en la raíz del
# repositorio: el servidor lo carga al arrancar (las variables ya definidas en el entorno
# tienen prioridad). En producción (Docker, Render) se definen en el propio servicio.

# development | production | test
NODE_ENV=development

# Puerto del servidor. En desarrollo, Vite (puerto 5173) reenvía /api a http://localhost:3000.
PORT=3000
# Interfaz de escucha. Por defecto: localhost en desarrollo y 0.0.0.0 en producción.
# HOST=0.0.0.0

# PostgreSQL. `docker compose up -d db` levanta uno con estos datos.
DATABASE_URL=postgres://chessblizzard:chessblizzard@localhost:5432/chessblizzard

# Aplicar las migraciones pendientes (server/migrations) al arrancar. Por defecto, true.
# A mano: npm run migrate -w server
MIGRATE_ON_START=true

# Cookie de sesión con el atributo Secure (solo viaja por HTTPS). Por defecto, true en
# producción y false en desarrollo.
# COOKIE_SECURE=true

# Web compilada que sirve el servidor. Por defecto ../client/dist (relativo a server/).
# Si no existe, el servidor arranca igual y solo sirve la API.
# CLIENT_DIST=../client/dist

# Detrás de un proxy (Render, nginx...): true, o la lista de IP/CIDR de los proxies, para que
# la IP del cliente salga de X-Forwarded-For. Sin proxy, false (si no, se podría falsear).
# TRUST_PROXY=false

# Orígenes extra admitidos en las peticiones que modifican datos (protección CSRF por la
# cabecera Origin), separados por comas. En desarrollo, por defecto los de Vite:
# http://localhost:5173 y http://localhost:4173 (y sus equivalentes con 127.0.0.1).
# ALLOWED_ORIGINS=https://chessblizzard.example

# Peticiones por IP y minuto en registro e inicio de sesión (cada ruta por separado).
# Por defecto: 10 en producción y 100 en desarrollo.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# Nivel de log: fatal, error, warn, info, debug, trace o silent.
# LOG_LEVEL=info

# Tests del servidor. Si no está definida, `npm test -w server` arranca un PostgreSQL
# desechable con server/scripts/test-db.sh (puerto 5433) y lo para al terminar.
# ¡Los tests borran las tablas de esa base de datos!
# TEST_DATABASE_URL=postgres://chessblizzard@127.0.0.1:5433/chessblizzard_test
